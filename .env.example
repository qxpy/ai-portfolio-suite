# Shared
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Document Copilot
DOC_CHAT_CHUNK_SIZE=900
DOC_CHAT_CHUNK_OVERLAP=180
DOC_CHAT_DEBUG=false

# Market Agent
MARKET_TOP_N=8
MARKET_WATCHLIST=bitcoin,ethereum,solana
MARKET_SCHEDULE_CRON=*/30 * * * *

# Competitor Monitor
COMPETITOR_DEFAULT_INTERVAL_HOURS=24
